# Reproducible map inputs and generated routing/rendering data
data/raw/*
!data/raw/.gitkeep
data/osrm/*
data/tiles/*
frontend/public/generated/*
!frontend/public/generated/.gitkeep
data/metadata/*
!data/metadata/.gitkeep
*.osrm*
*.mbtiles

# GPS recording files (sensitive location data)
ios/GpsSender/GpsSender/Documents/GPS_Recordings/*.jsonl

# Local tooling and generated output
.venv/
__pycache__/
.pytest_cache/
node_modules/
dist/
.vite/
*.log
.env.gps.local
gps-receiver*.log
.DS_Store
.superpowers/

# Xcode and iOS build artifacts
ios/**/*.xcuserstate
ios/**/*.xcuserdata/
ios/**/*.swiftpm/
ios/DerivedData/
ios/build/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# Office document build artifacts (if any)
.docx-build/
.pptx-build/
artifacts/

# IDE files
.vscode/
.idea/
*.iml
